# Oficina Inji local: substitua SEU_IP_DA_REDE pelo IPv4 do computador
# alcançável pelo emulador Android, pelo navegador e pelos contêineres.
# Use o mesmo IP configurado em WORKSHOP_HOST no Docker Compose da oficina.
# Não use localhost nem 10.0.2.2: o eSignet publica esse endereço como issuer.
EXPO_PUBLIC_WORKSHOP_AUTH_URL=http://SEU_IP_DA_REDE:31080/authorize
EXPO_PUBLIC_WORKSHOP_CERTIFY_URL=http://SEU_IP_DA_REDE:31090/v1/certify
EXPO_PUBLIC_WORKSHOP_MIMOTO_URL=http://SEU_IP_DA_REDE:31099

# Estas variáveis são embutidas no aplicativo. Nunca coloque tokens, senhas,
# chaves privadas ou client secrets em variáveis EXPO_PUBLIC_.